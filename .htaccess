# Gostinho de Casa — Hostinger PHP

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{DOCUMENT_ROOT}/SITE_OFF -f
  RewriteCond %{REQUEST_URI} !/offline\.html$ [NC]
  RewriteRule ^ offline.html [L]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteRule ^cardapio/?$ cardapio.html [L]
  RewriteRule ^carrinho/?$ carrinho.html [L]
  RewriteRule ^checkout/?$ checkout.html [L]
  RewriteRule ^produto/?$ produto.html [L]
  RewriteRule ^pedido/?$ pedido.html [L]
  RewriteRule ^login/?$ admin/login.html [L]
  RewriteRule ^admin/?$ admin/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(catalog\.json|index\.html|cardapio\.html|carrinho\.html|checkout\.html)$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>
