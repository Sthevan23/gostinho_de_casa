# Gostinho de Casa — Hostinger PHP

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{DOCUMENT_ROOT}/SITE_OFF -f
  RewriteCond %{REQUEST_URI} !/offline\.html$ [NC]
  RewriteRule ^ offline.html [L]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteRule ^cardapio/?$ / [R=302,L,QSA]
  RewriteRule ^buscar/?$ / [R=302,L,QSA]
  RewriteRule ^carrinho/?$ carrinho.html [L]
  RewriteRule ^checkout/?$ checkout.html [L]
  RewriteRule ^produto/([A-Za-z0-9_-]+)/?$ produto.html?id=$1 [L,QSA]
  RewriteRule ^produto/?$ produto.html [L,QSA]
  RewriteRule ^pedido/?$ pedido.html [L,QSA]
  RewriteRule ^pedidos/?$ pedidos.html [L]
  RewriteRule ^conta/?$ / [R=302,L]
  RewriteRule ^favoritos/?$ favoritos.html [L]
  RewriteRule ^marmitas/?$ /?categoria=caseiras [R=302,L,QSA]
  RewriteRule ^promocoes/?$ /?categoria=prato-da-semana [R=302,L,QSA]
  RewriteRule ^login/?$ admin/login.html [L]
  RewriteRule ^admin/?$ admin/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>
